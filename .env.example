NEXT_PUBLIC_SITE_URL=https://polpas-becal.vercel.app

# Supabase → Project Settings → API. Sem estas duas variáveis, loja e painel rodam em modo
# demonstração (catálogo local, nada gravado no banco). Na Vercel elas são obrigatórias.
# A chave publishable é pública por definição; quem protege os dados são as políticas (RLS)
# de supabase/migrations. Nunca use service_role ou sb_secret no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
